# LinkIntel AI Backend Environment Configuration
APP_ENV=development
APP_NAME="LinkIntel AI"
APP_PORT=4000

# Primary LLM Provider: gemini, openai, anthropic, or mock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# API Credentials (Set your private provider key)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web Search Provider for Live Competitor Research (duckduckgo, brave, tavily)
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=

# Security & CORS (comma-separated origins)
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://192.168.0.133:8080,http://localhost:3000,http://localhost:5173,http://localhost:4173
REQUEST_TIMEOUT_SECONDS=20
MAX_RESPONSE_BYTES=5000000
MAX_REDIRECTS=3
MAX_INTERNAL_PAGES=4
MAX_EXTRACTED_CHARS=40000
CACHE_TTL_SECONDS=3600
